---
import Forms from './Forms.astro';
---

<main>
	<section class="converter-app">
		<h1>Lancaster University Grade Converter</h1>
		<p>Convert between grades, aggregation scores, and percentages.</p>
		<Forms />
		<p style="font-style: italic; font-family: serif;">Data updated 15/09/2026 from <a href="https://web.archive.org/web/20260914233103/https://www.lancaster.ac.uk/media/lancaster-university/content-assets/documents/student-based-services/asq/marp/UG-Assess-Regs.pdf">here</a>.</p>
	</section>
</main>

<style>
	main {
		display: flex;
		min-height: 100%;
		padding: 2rem;
		box-sizing: border-box;
		align-items: center;
		justify-content: center;
		background-color: #ffffff;
		opacity: 0.7;
		background-image:  repeating-linear-gradient(to right, transparent 0, transparent 1.6666666666666667px, #ffffff 1.6666666666666667px, #ffffff 5px, transparent 5px, transparent 6.666666666666667px), repeating-linear-gradient(to bottom, transparent 0, transparent 1.6666666666666667px, #ffffff 1.6666666666666667px, #ffffff 5px, transparent 5px, transparent 6.666666666666667px), linear-gradient(to bottom, #ff0000 0.6px, transparent 0.6px), linear-gradient(to right, #ff0000 0.6px, transparent 0.6px) ;
		background-size: 100% 100%, 100% 100%, 20px 20px, 20px 20px;
		background-position: 0 0, 0 0, 0 -0.2px, -0.2px 0;
	}

	.converter-app {
		width: min(100%, 42rem);
		padding: 2.5rem;
		background: #ffffff;
		border: 1px solid #e5e7eb;
		border-radius: 0.75rem;
		box-shadow: 0 0rem 2rem rgb(15 23 42 / 40%);
	}

	h1 {
		margin: 0;
		color: #111827;
		font-size: 1.75rem;
	}

	p {
		margin: 0.75rem 0 2rem;
		color: #6b7280;
		line-height: 1.5;
	}

	@media (max-width: 640px) {
		main {
			padding: 1rem;
		}

		.converter-app {
			padding: 1.5rem;
		}
	}
</style>
