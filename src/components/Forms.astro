---
---

<form id="form">
    <div class="field">
        <label for="grade">Grade</label>
        <select name="grade" id="grade">
            <option value="A+">A+</option>
            <option value="A">A</option>
            <option value="A-">A-</option>
            <option value="B+">B+</option>
            <option value="B">B</option>
            <option value="B-">B-</option>
            <option value="C+">C+</option>
            <option value="C">C</option>
            <option value="C-">C-</option>
            <option value="D+">D+</option>
            <option value="D">D</option>
            <option value="D-">D-</option>
            <option value="F1">Marginal Fail (F1)</option>
            <option value="F2">Fail (F2)</option>
            <option value="F3">Poor Fail (F3)</option>
            <option value="F4">Very Poor Fail (F4)</option>
        </select>
    </div>

    <div class="field">
        <label for="ag-score">Aggregation Score</label>
        <input type="number" id="ag-score" name="ag-score" min="0" max="24" />
    </div>

    <div class="field">
        <label for="percentage">Percentage</label>
        <input
            type="number"
            id="percentage"
            name="percentage"
            min="0"
            max="100"
        />
    </div>
</form>

<script>
    const form = document.getElementById("form");

    const gradeField = document.getElementById("grade");
    const aggregateField = document.getElementById("ag-score");
    const percentageField = document.getElementById("percentage");

    // Monitor fields and update conversion on change
    gradeField.addEventListener("input", (e) => {
        let gradeValue = document.getElementById("grade").value;

        let percentField = document.getElementById("percentage");
        let aggregateField = document.getElementById("ag-score");

        // Populate conversions
        let convPercent = getFromGrade(gradeValue, "Percent");
        let convAggregate = getFromGrade(gradeValue, "Aggregate");

        if (convPercent) {
            percentField.value = convPercent;
        }
        if (convAggregate) {
            aggregateField.value = convAggregate;
        }
    });

    aggregateField.addEventListener("input", (e) => {
        let aggregateValue = document.getElementById("ag-score").value;
        let percentField = document.getElementById("percentage");
        let gradeField = document.getElementById("grade");

        let convPercent = getFromAggregate(aggregateValue, "Percent");
        let convGrade = getFromAggregate(aggregateValue, "Grade");

        if (convPercent) {
            percentField.value = convPercent;
        }
        if (convGrade) {
            gradeField.value = convGrade;
        }
    });

    percentageField.addEventListener("input", (e) => {
        const percentageValue = Number(percentageField.value);
        const aggregateField = document.getElementById("ag-score");
        const gradeField = document.getElementById("grade");

        if (!Number.isFinite(percentageValue)) {
            return;
        }

        let convAggregate = getFromPercent(percentageValue, "Aggregate");
        let convGrade = getFromPercent(percentageValue, "Grade");

        if (convAggregate) {
            aggregateField.value = convAggregate;
        }
        if (convGrade) {
            gradeField.value = convGrade;
        }
    });
    let grades = [
        { grade: "A+", aggregate: "24", percentage: "100" },
        { grade: "A", aggregate: "21", percentage: "80" },
        { grade: "A-", aggregate: "18", percentage: "70" },
        { grade: "B+", aggregate: "17", percentage: "66.66" },
        { grade: "B", aggregate: "16", percentage: "63.5" },
        { grade: "B-", aggregate: "15", percentage: "53" },
        { grade: "C+", aggregate: "14", percentage: "46" },
        { grade: "C", aggregate: "13", percentage: "40" },
        { grade: "C-", aggregate: "12", percentage: "33" },
        { grade: "D+", aggregate: "11", percentage: "26" },
        { grade: "D", aggregate: "10", percentage: "20" },
        { grade: "D-", aggregate: "9", percentage: "13" },
        { grade: "F1", aggregate: "7", percentage: "31" },
        { grade: "F2", aggregate: "4", percentage: "18" },
        { grade: "F3", aggregate: "2", percentage: "9" },
        { grade: "F4", aggregate: "0", percentage: "0" },
    ];

    function getFromGrade(grade, conversionType) {
        const match = grades.find((row) => {
            return grade == row.grade;
        });

        if (conversionType == "Percent") {
            return match?.percentage;
        } else {
            return match?.aggregate;
        }
    }

    function getFromAggregate(aggregate, conversionType) {
        const match = grades.find((row) => {
            return aggregate == row.aggregate;
        });

        if (conversionType == "Percent") {
            return match?.percentage;
        } else {
            return match?.grade;
        }
    }

    function getFromPercent(percentage, conversionType) {
        const match = grades.reduce((bestMatch, row) => {
            const rowPercentage = Number(row.percentage);

            if (
                Number(percentage) >= rowPercentage &&
                (!bestMatch || rowPercentage > Number(bestMatch.percentage))
            ) {
                return row;
            }

            return bestMatch;
        }, undefined);

        if (conversionType == "Grade") {
            return match?.grade;
        } else {
            return match?.aggregate;
        }
    }
</script>

<style>
    form {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.25rem;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
        min-height: 6rem;
    }

    label {
        color: #374151;
        font-size: 0.875rem;
        font-weight: 600;
        line-height: 1.25rem;
    }

    input,
    select {
        box-sizing: border-box;
        width: 100%;
        height: 2rem;
        padding: 0.5rem 0.5rem;
        border: 1px solid #d1d5db;
        border-radius: 0.8rem;
        font-size: 1rem;
    }

    input:focus,
    select:focus {
        outline: 3px solid #bfdbfe;
        outline-offset: 1px;
        border-color: #2563eb;
    }

    @media (max-width: 640px) {
        form {
            grid-template-columns: 1fr;
        }
    }
</style>
